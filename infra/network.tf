# =================================================================
# ネットワーク（WBS No.2.1）
#   VPC / サブネット / インターネットゲートウェイ / ルートテーブル
#   EC2 をインターネットへ出せる単一 AZ・単一パブリックサブネットの最小構成
# Last updated: 2026-09-22 17:17:32
# =================================================================

# -----------------------------------------------------------------
# VPC
#   DNS ホスト名・DNS 解決を有効化する
# -----------------------------------------------------------------
resource "aws_vpc" "main" {
  cidr_block           = var.vpc_cidr
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "${var.prj_prefix}-vpc-010"
  }
}

# -----------------------------------------------------------------
# サブネット
#   VPC 内に単一のパブリックサブネットを作成する
# -----------------------------------------------------------------
resource "aws_subnet" "main" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = var.subnet_cidr
  availability_zone = var.availability_zone

  tags = {
    Name = "${var.prj_prefix}-subnet-010"
  }
}

# -----------------------------------------------------------------
# インターネットゲートウェイ
#   VPC にアタッチする（vpc_id 指定によりアタッチも同時に行われる）
# -----------------------------------------------------------------
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.prj_prefix}-igw-010"
  }
}

# -----------------------------------------------------------------
# ルートテーブル
#   VPC のメインルートテーブルは編集せず、管理範囲を明確にするため
#   専用ルートテーブルを新規作成する。
#   0.0.0.0/0 を IGW へ向けるデフォルトルートを持たせる。
# -----------------------------------------------------------------
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = {
    Name = "${var.prj_prefix}-rtt-010"
  }
}

# -----------------------------------------------------------------
# ルートテーブルの関連付け
#   作成したサブネットを上記ルートテーブルに紐付け、
#   サブネットからインターネットへ到達できるようにする
# -----------------------------------------------------------------
resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.main.id
  route_table_id = aws_route_table.public.id
}
